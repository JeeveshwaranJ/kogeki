# ==========================================
# Discord Anime Attack Bot Configuration
# ==========================================

# Your Discord Bot Token (From Discord Developer Portal -> Bot -> Reset/Copy Token)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application (Client) ID (From Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Your Test Discord Server (Guild) ID for INSTANT slash command updates
# (Right-click your server icon in Discord with Developer Mode enabled -> Copy Server ID)
GUILD_ID=your_server_id_here

# Command Prefix (default is !)
PREFIX=!

# HP Restoration Time in seconds after a user is defeated (default is 60 seconds)
HP_RESTORE_TIME_SECONDS=60
